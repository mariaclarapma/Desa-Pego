{
  "name": "desa-pego",
  "version": "0.1.0",
  "private": true,
  "description": "desaPego: brechó online (Desenvolvimento Web, CEUB 2026)",
  "workspaces": [
    "core",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c magenta,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "reset-db": "npm run reset-db -w backend",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "node scripts/iniciar.mjs",
    "gerar-env": "node scripts/gerar-env.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:abrir": "node scripts/e2e.mjs --abrir",
    "cobertura": "node scripts/cobertura.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
