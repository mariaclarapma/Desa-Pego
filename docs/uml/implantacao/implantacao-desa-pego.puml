@startuml
!include ../_estilo.iuml
!pragma layout smetana
set separator none
title Desa Pego · Diagrama de implantação\n<size:11>Produção hoje: um serviço web no Render (plano grátis) e o banco no Supabase · https://desapego.onrender.com</size>

node "Dispositivo da usuária" as DEV {
  node "Navegador" as BROWSER
}

node "Render · Ohio (plano grátis)" as RENDER {
  node "Serviço web (Node.js 22)\nnpm start → concurrently" as WEB {
    artifact "site\nNext.js · porta pública" as SITE
    artifact "contas\nExpress · 127.0.0.1:3002" as CONTAS
    artifact "catalogo\nExpress · 127.0.0.1:3001" as CAT
    artifact "pedidos\nExpress · 127.0.0.1:3003" as PED
    artifact "db.json\n(disco temporário)" as JSON
  }
}

node "Supabase · Ohio" as SUPA {
  database "PostgreSQL\nschemas contas e pedidos" as PG
}

node "GitHub" as GH {
  artifact "repositório\n+ GitHub Actions (CI)" as REPO
}

cloud "ViaCEP" as CEP

BROWSER --> SITE : HTTPS
BROWSER ..> CEP : HTTPS (busca do CEP)
SITE --> CONTAS : HTTP local (/api/auth)
SITE --> CAT : HTTP local (/api)
SITE --> PED : HTTP local (/api/gestao)
CAT --> PED : HTTP local /interno\n(X-API-Key)
CAT --> JSON
CONTAS --> PG : TLS (DATABASE_URL)
PED --> PG : TLS (DATABASE_URL)
REPO --> RENDER : deploy automático\na cada push na main

legend bottom
  Os três serviços só escutam em 127.0.0.1: de fora, tudo passa pelo site (proxy /api).
  Segredos (JWT_SECRET, API_KEYS, chaves do CPF, DATABASE_URL) ficam nas variáveis de ambiente do Render.
  O db.json do catálogo volta à semente a cada deploy: migrar o catálogo para o PostgreSQL é o próximo passo.
  A arquitetura planejada (AWS, ECS Fargate, Cloudflare) está em implantacao-planejada-aws.puml.
endlegend
@enduml
