@startuml
!include ../_estilo.iuml
title UC03 · Buscar peças na vitrine e consultar detalhes — Diagrama de sequência\n<size:11>Requisitos 007 e 008 · catálogo · sem login</size>
autonumber
hide footbox

actor "Visitante ou compradora" as V
participant "Site\n(Next.js, renderizado no servidor)" as FE
box "Serviço do catálogo" #FBFBFB
  participant "Rotas\n(app.ts)" as R
  participant ":Loja\n(db.json)" as L
end box

== Vitrine com busca e filtros ==
V -> FE : /catalogo?busca=jaqueta&categoria=feminino&ordem=menor-preco
FE -> R : GET /pecas?busca&categoria&tamanho&condicao\n&precoMin&precoMax&ordem&pagina&porPagina
R -> R : valida os parâmetros (Zod);\ncampo vazio conta como não informado
alt parâmetro inválido (ex.: preço mínimo maior que o máximo)
  R --> FE : 400 com o campo errado
else
  R -> L : lista as peças
  R -> R : tira vendidas e ocultadas pela administração;\nbusca sem diferenciar maiúsculas e acentos;\nordena e corta a página
  R --> FE : 200 { itens, total, pagina, porPagina }
  FE --> V : grade de peças com paginação
end

== Detalhes da peça ==
V -> FE : abre /peca/{id}
FE -> R : GET /pecas/{id}
alt peça não existe ou foi ocultada
  R --> FE : 404
  FE --> V : página "não encontrada"
else
  R -> R : reserva vencida volta a contar como disponível;\nquem reservou nunca aparece
  R --> FE : 200 peça
  alt disponível
    FE --> V : fotos, medidas, condição e "colocar na sacola" (UC04)
  else reservada ou vendida
    FE --> V : botão trocado por "reservada por outra pessoa"\nou "essa peça já foi vendida"
  end
end
@enduml
