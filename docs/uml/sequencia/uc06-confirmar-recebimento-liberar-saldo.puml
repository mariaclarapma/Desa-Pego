@startuml
!include ../_estilo.iuml
title UC06 · Acompanhar a entrega e liberar o saldo — Diagrama de sequência\n<size:11>Requisitos 013 e 014 · Módulo 05 (pedidos, carteira e administração)</size>
autonumber
hide footbox

actor Vendedora
actor Compradora
actor Administradora
participant "Site\n(Next.js)" as FE
box "Serviço de pedidos (Módulo 05)" #FBFBFB
  participant "Rotas\n(app.ts)" as R
  participant "Máquina de estados\n(estados.ts)" as E
  database "PostgreSQL\n(schema pedidos)" as DB
end box

== Vendedora marca o envio ==
Vendedora -> FE : /conta/vendas → "marcar como enviado"
FE -> R : POST /pedidos/{id}/enviar (Bearer)
R -> DB : lê o pedido
R -> E : conferirTransicao(PAGO → ENVIADO, vendedora)
alt quem chamou não participa do pedido
  R --> FE : 403 "este pedido não é seu"
else transição fora da tabela (ex.: ainda não pago)
  E --> R : transição inválida
  R --> FE : 409
else permitido
  R -> DB : status → ENVIADO
  R --> FE : 200
  FE --> Vendedora : linha do tempo atualizada
end

== Compradora confirma o recebimento ==
Compradora -> FE : /conta/compras → "confirmar recebimento"
FE -> R : POST /pedidos/{id}/confirmar-recebimento (Bearer)
R -> E : conferirTransicao(ENVIADO → ENTREGUE, compradora)
alt a vendedora tenta confirmar no lugar dela
  R --> FE : 403
else permitido
  R -> DB : status → ENTREGUE
  R -> DB : lançamento LIBERACAO: pendente − valor, disponível + valor
  note right of DB : livro-razão: nada é alterado nem apagado;\no saldo é a soma dos lançamentos
  R --> FE : 200
end

== Vendedora pede o repasse ==
Vendedora -> FE : /conta/carteira
FE -> R : GET /carteira (Bearer)
R -> DB : soma os lançamentos da vendedora
R --> FE : pendente, disponível, extrato
Vendedora -> FE : "solicitar repasse"
FE -> R : POST /carteira/repasses { valor }
alt valor maior que o saldo disponível
  R --> FE : 422
else
  R -> DB : repasse SOLICITADO
  R --> FE : 201
end
Administradora -> FE : /admin → "marcar como pago"
FE -> R : POST /admin/repasses/{id}/pagar (Bearer, ADMIN_MASTER)
R -> DB : repasse PAGO + lançamento REPASSE (disponível − valor)
R --> FE : 200
@enduml
