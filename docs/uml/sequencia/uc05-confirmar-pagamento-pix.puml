@startuml
!include ../_estilo.iuml
title UC05 · Confirmar o pagamento Pix (webhook) — Diagrama de sequência\n<size:11>Requisitos 011 e 014 · catálogo + Módulo 05 (pedidos e carteira) · padrão Facade (CompraFacade)</size>
autonumber
hide footbox

actor "Provedor Pix\n<size:10>(no MVP: botão simular pagamento)</size>" as PIX
participant "Site\n(server action)" as SA
box "Serviço do catálogo" #FBFBFB
  participant "Rotas de integração\n(/integracao)" as R
  participant ":CompraFacade" as F
  participant ":Loja\n(db.json)" as L
end box
box "Serviço de pedidos (Módulo 05)" #FBFBFB
  participant "Rotas internas\n(/interno)" as M5
  database "PostgreSQL\n(schema pedidos)" as DB
end box

PIX -> SA : pagamento confirmado
note right of SA : a API key fica no servidor do site;\nnunca chega ao navegador
SA -> R : POST /integracao/pagamentos/{id}/confirmar\n(X-API-Key)
alt chave ausente ou errada
  R --> SA : 401
else chave válida
  R -> F : confirmarPagamento(compraId)
  F -> L : alterarEmFila
  alt compra já paga (webhook repetido)
    F --> R : compra como está
    R --> SA : 200 (nada muda)
  else prazo do Pix vencido
    F -> M5 : POST /interno/pedidos/{id}/expirar
    F -> L : compra cancelada, peças voltam à vitrine
    R --> SA : 409 "o prazo deste Pix acabou"
  else aguardando pagamento
    loop para cada pedido da compra (um por vendedora)
      F -> M5 : POST /interno/pedidos/{id}/pagamento-confirmado
      alt pedido já PAGO
        M5 --> F : 200 (idempotente: não lança de novo)
      else AGUARDANDO_PAGAMENTO
        M5 -> DB : status → PAGO
        M5 -> DB : lançamentos: vendedora (pendente),\ncomissão e taxa do Pix
        M5 --> F : 200
      end
    end
    alt o Módulo 05 não respondeu
      F --> R : Recusa 502
      R --> SA : 502 (nada mudou no catálogo;\no provedor pode repetir)
    else todos confirmados
      F -> L : compra PAGA; peças VENDIDAS
      F --> R : compra paga
      R --> SA : 200
      SA --> PIX : recebido
    end
  end
end
note over F, M5 : ordem que permite repetir: o Módulo 05 é avisado antes de o catálogo mudar
@enduml
