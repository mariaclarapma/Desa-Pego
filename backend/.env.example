# Copie para backend/.env (fora do Git) e preencha. Nunca suba o .env.

# PostgreSQL das contas (ex.: Supabase → Connect → Session pooler). Sem ele, o banco fica em
# memória e as contas somem quando o serviço reinicia (bom para desenvolver e para os testes).
DATABASE_URL=

# Em desenvolvimento, sem JWT_SECRET, o serviço gera um segredo temporário a cada início.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORTA_CONTAS=3002
COOKIE_PATH=/api/auth

# Proxies confiáveis para ler o IP real (limite de tentativas). Local: loopback.
# No Render: loopback, uniquelocal (já vem no render.yaml).
TRUST_PROXY=loopback
