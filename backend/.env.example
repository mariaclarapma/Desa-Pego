# Copie para backend/.env (fora do Git) e preencha. Em desenvolvimento, sem JWT_SECRET, o serviço
# gera um segredo temporário a cada início (as sessões caem ao reiniciar).
# Gere um segredo com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
PORTA_CONTAS=3002
COOKIE_PATH=/api/auth
