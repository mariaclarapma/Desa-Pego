{
  "name": "desapego-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do desaPego: catálogo com json-server e serviço de contas (Express + PostgreSQL). No sistema final, o lugar é do NestJS.",
  "scripts": {
    "dev": "concurrently -n catalogo,contas -c magenta,yellow \"npm:dev:catalogo\" \"npm:dev:contas\"",
    "dev:catalogo": "npm run prepare-db && json-server db.json --port 3001",
    "dev:contas": "tsx watch contas/src/servidor.ts",
    "start:contas": "tsx contas/src/servidor.ts",
    "test": "vitest run --root contas",
    "typecheck": "tsc --noEmit -p contas",
    "prepare-db": "node -e \"const f=require('fs');if(!f.existsSync('db.json'))f.copyFileSync('db.seed.json','db.json')\"",
    "reset-db": "node -e \"require('fs').copyFileSync('db.seed.json','db.json')\"",
    "start:catalogo": "npm run prepare-db && json-server db.json --port 3001"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "json-server": "^1.0.0-beta.15",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "zod": "^4.6.7"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
